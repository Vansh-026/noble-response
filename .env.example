# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/intellichat

# JWT Authentication Secrets (Must be long, cryptographically random strings in production)
JWT_SECRET=your_jwt_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Render Deployed Backend URL (used by Vite client and Vercel)
VITE_API_URL=https://intelligentchat.onrender.com

# AI Backend Webhook Integration
VITE_N8N_WEBHOOK_URL=https://n8n-v3-tjln.onrender.com/webhook/mychatapp

# Allowed Frontend URL for Credentialed CORS
FRONTEND_URL=https://intellichat-sigma.vercel.app

# Optional: Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
